# Sigil server configuration (copy to .env and adjust).

# Postgres connection string. If unset, an in-memory store is used and data is
# not persisted across restarts (handy for local demos and tests).
# DATABASE_URL=postgres://sigil:sigil@localhost:5432/sigil

# Public host (and optional port) the issuer is reachable at. Used to build the
# issuer did:web, credential ids and status list URLs.
SIGIL_ISSUER_HOST=localhost:8080

# Socket address the HTTP server binds to.
SIGIL_BIND=0.0.0.0:8080

# Base64-encoded PKCS#8 DER Ed25519 signing key for the issuer. If unset, an
# ephemeral key is generated on startup (the did:web will change each restart).
# Generate one with: cargo run --bin sigil-keygen   (or supply your own)
# SIGIL_ISSUER_KEY_PKCS8_B64=

# Log filter.
RUST_LOG=info,sigil_server=debug
